.pycache

# Локальный запуск тестового бота (содержит токен)
run_test_bot.sh

# Отчёт и журналы живого прогона (logs/ уже исключён выше).
logs/live-test-*

# Сырые выгрузки ошибок: содержат имена сотрудников (персональные данные).
