# ============================================================
# Telegram
# ============================================================
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Необязательно: белый список chat_id через запятую. Если задан,
# бот игнорирует все остальные чаты. Свой chat_id узнать командой /id.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Топики форум-группы -------------------------------------------------
# Бот обрабатывает сообщения только из одного топика. Команды (/id, /reg,
# /help) работают в любом топике, чтобы можно было настроиться.
#
# В Bot API нет метода «узнать имя топика по id», поэтому самый надёжный
# путь — TELEGRAM_TOPIC_ID: отправьте /id внутри нужного топика и впишите
# полученный message_thread_id сюда.
# TELEGRAM_TOPIC_ID=27

# Имя топика (необязательно). Сработает, только если бот уже видел
# сервисное сообщение о создании/переименовании этого топика.
TELEGRAM_TOPIC_NAME=Ex GLPC

# Отвечать ли в чужом топике подсказкой «здесь не отслеживается»
# (один раз на топик, true/false).
TELEGRAM_WRONG_TOPIC_HINT=true

# Присылать ли подтверждение об успешной записи (true/false)
TELEGRAM_CONFIRM=true

# Сколько секунд ждать описание причины при смене статуса робота
# (/offline, /online): после этого флоу сбрасывается.
TELEGRAM_STATUS_FLOW_TTL=300

# ============================================================
# Топики форума по назначению
# ============================================================
# Значение — id топика (узнать: /id в этом топике) или имя топика.
# TELEGRAM_TOPIC_ID — топик ошибок склада по умолчанию: только ошибки,
# бот берёт их только отсюда. Остальные топики — куда уходят ответы.
TELEGRAM_TOPIC_STATUS=
TELEGRAM_TOPIC_STATS=
TELEGRAM_TOPIC_SERVICE=

# Склады, которые ведёт бот: ключ=название в базе. Ключ используется в
# переменных и в командах (/stats sp3 day, /top sp3 week).
TELEGRAM_WAREHOUSES=glpc=GLP-C,sp3=SMALL-P3

# Топик ошибок для каждого склада: TELEGRAM_TOPIC_ERROR_<КЛЮЧ>.
# Для склада по умолчанию (glpc) достаточно TELEGRAM_TOPIC_ID выше.
TELEGRAM_TOPIC_ERROR_GLPC=
TELEGRAM_TOPIC_ERROR_SP3=

# В топике ошибок — только ошибки: ответы на команды уходят в свой топик.
# false — вернуть прежнее поведение «отвечаю там, где спросили».
TELEGRAM_ERROR_TOPIC_STRICT=true

# Короткая самоудаляющаяся подсказка «ответ в другом топике».
TELEGRAM_MOVED_HINT=true

# Через сколько секунд удалять свои служебные подтверждения
# («✅ Saved», «✅ Photo forwarded») — чтобы группа не зарастала хвостами.
# 0 — не удалять вообще.
TELEGRAM_CONFIRM_TTL=10

# ============================================================
# Lark
# ============================================================
# Нужен только для загрузки фото в webhook (im/v1/images).
# Если фото пересылать не нужно — можно не заполнять.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook custom-бота целевой группы Lark.
# Если не задан — используется значение по умолчанию из pending_photos.py
LARK_TARGET_HOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Секрет подписи webhook (только если в настройках бота включена подпись)
LARK_HOOK_SECRET=

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Фото (резервное хранилище)
# ============================================================
# Используется, когда Lark API недоступен по квоте (code 99991403):
# фото грузится сюда, а в Lark-группу уходит ссылка.
SUPABASE_PHOTO_BUCKET=bot-photos

# true — публичный bucket (ссылка постоянная), false — приватный + signed URL
SUPABASE_PHOTO_BUCKET_PUBLIC=false

# Время жизни signed-ссылки в секундах (по умолчанию 1 год)
SUPABASE_SIGNED_URL_TTL=31536000

# ============================================================
# Защита от дублей (лиз единственного опрашивающего)
# ============================================================
# Имя лиза: разные боты (GLP-C, P3, ...) друг другу не мешают.
BOT_LEASE_NAME=glpc-bot-telegram

# Через сколько секунд без heartbeat лиз считается брошенным.
# При остановке контейнера лиз отпускается сразу (SIGTERM), а TTL — страховка.
BOT_LEASE_TTL=90

# Как часто отдельный поток продлевает лиз (обработка фото может занять минуты).
BOT_LEASE_HEARTBEAT=15

# Если опрашивающий инстанс не делал getUpdates дольше этого времени,
# /health отдаёт 503 и Railway перезапускает контейнер.
POLL_STALL_SECONDS=180

# Сколько секунд дать текущему апдейту дописаться при остановке контейнера.
SHUTDOWN_GRACE_SECONDS=3

# Объединять ли фото с записью об ошибке (привязка, ожидание текста,
# ссылка в колонке photo_url). По умолчанию ВЫКЛЮЧЕНО: фото просто уходит
# в Lark-группу, как раньше.
PHOTO_ATTACH_ENABLED=false

# Удалять ли сообщения сотрудников: команды боту и описание причины при
# смене статуса. Сообщения об ошибках и сообщения о смене статуса остаются.
# В личке бот чужие сообщения не удаляет (проверка по типу чата).
DELETE_USER_MESSAGES=true

# Короткие ссылки на фото: <домен>/p/<файл> вместо длинного signed URL.
PHOTO_LINK_BASE=https://glpc-bot-lark-production.up.railway.app

# true — отдавать публичные ссылки Supabase (bucket станет публичным),
# false — короткая ссылка на наш /p/<файл> (bucket остаётся приватным).
PUBLIC_PHOTO_URLS=false

# К ошибке какой давности прикрепляется присланное фото (секунды).
PHOTO_ATTACH_WINDOW=600

# Сколько секунд держать фото, ожидая текст ошибки, прежде чем переслать
# его отдельно (0 — пересылать сразу).
PHOTO_HOLD_SECONDS=90

# Сколько дней хранить скачанные из Telegram фото (0 — не удалять).
IMAGES_RETENTION_DAYS=7

# Максимальный размер скачиваемого из Telegram файла, МБ.
TELEGRAM_MAX_FILE_MB=25

# Необязательный токен для HTTP-эндпоинта /shift_stats (пусто — открыт).
STATS_TOKEN=

# ============================================================
# Логика бота
# ============================================================
# Сколько ошибок робота за смену считается поводом для алерта
ERROR_THRESHOLD=3

# Сообщения старше N секунд не обрабатываем (защита от «хвоста» апдейтов)
MESSAGE_MAX_AGE_SECONDS=300

# Куда складывать фото из Telegram
IMAGES_DIR=images

# Куда писать лог-файл
LOG_DIR=logs

# Уровень логов: DEBUG, INFO (по умолчанию), WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================
# Прочие настройки (у всех есть разумные значения по умолчанию)
# ============================================================
# Как часто standby-инстанс пробует забрать лиз (секунды)
BOT_STANDBY_RETRY=10

# Сколько раз повторять обработку упавшего апдейта, прежде чем пропустить
MAX_UPDATE_ATTEMPTS=3

# Сколько ждать первого опроса, прежде чем /health станет нездоровым
STARTUP_GRACE_SECONDS=60

# Планировщик отчётов за смену
CHECK_INTERVAL_SECONDS=30
REPORT_WINDOW_MINUTES=15
REPORT_TOP=5
REPORT_WARN_TOTAL=5

# Bucket'ы Supabase Storage (создаются автоматически)
SUPABASE_STATE_BUCKET=bot-state
SUPABASE_REPORT_BUCKET=bot-reports

# ============================================================
# Вебхуки Lark: у ошибок и у смены статусов разные группы, у каждого склада свои
# ============================================================
# Общий вебхук: им пользуются отчёты, и он же — запасной для всего, что не
# переопределено ниже. Историческая переменная (ошибки GLP-C).
LARK_TARGET_HOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/dc2c430d-ce07-4ff2-b5ca-0b92feb4f62a

# Ошибки по складам (ключи — из TELEGRAM_WAREHOUSES).
LARK_HOOK_ERROR_GLPC=
LARK_HOOK_ERROR_SP3=

# Смена статусов роботов (online/offline) по складам.
LARK_HOOK_STATUS_GLPC=
LARK_HOOK_STATUS_SP3=

# Короткие ссылки /p/<файл>: сколько подписанных URL держать в памяти
# и сколько секунд помнить, что файла нет (защита от перебора имён).
SIGNED_URL_CACHE_MAX=512
SIGNED_URL_MISS_TTL=300

# Через сколько секунд перепроверять таблицу bot_leases, если проверка
# упала по сети/5xx (это не «таблицы нет», поэтому повтор быстрый).
LEASE_TABLE_ERROR_RETRY_SECONDS=20

# ============================================================
# Карточка робота (/robot) и исправление номера
# ============================================================
# Предлагать ли похожие номера, когда робота нет в справочнике.
ROBOT_FIX_SUGGEST=true

# Сколько секунд ждать ответа сотрудника (потом номер уходит как есть).
ROBOT_FIX_TTL=180

# Порог схожести номеров и сколько вариантов показывать.
ROBOT_FIX_CUTOFF_PERCENT=85
ROBOT_FIX_LIMIT=3

# Кэши /robot (секунды): карточка робота и список номеров склада.
ROBOT_CARD_CACHE_SECONDS=60
ROBOT_NUMBERS_CACHE_SECONDS=600

# Окно и глубина истории в карточке.
ROBOT_CARD_WINDOW_DAYS=7
ROBOT_CARD_HISTORY=5

# Автозакрытие очереди robots_to_add: заявки, чей робот уже в справочнике.
QUEUE_AUTOCLOSE_ENABLED=true
QUEUE_AUTOCLOSE_INTERVAL=1800
QUEUE_SCAN_LIMIT=2000

# ============================================================
# Дайджест обслуживания (в личку) и простой в отчёте
# ============================================================
# Кому слать дайджест: список Telegram id через запятую. Пусто — уйдёт
# зарегистрированным сотрудникам с employees.is_leader = true.
ROBOT_ADMIN_TELEGRAM_IDS=

# Включён ли ежедневный дайджест и после какого часа (по Варшаве) его слать.
DIGEST_ENABLED=true
DIGEST_HOUR=9
DIGEST_CHECK_INTERVAL=60

# Порог «робот залип в офлайне» и сколько строк показывать.
STALE_OFFLINE_HOURS=24
STALE_OFFLINE_LIMIT=10

# Сколько последних открытых заявок robots_to_add показывать.
QUEUE_DIGEST_TOP=5

# Сколько строк журнала смен статуса читать для MTTR (журнал небольшой).
DOWNTIME_HISTORY_LIMIT=4000

# ============================================================
# Аналитика (/top, /downtime) и недельный отчёт в Lark
# ============================================================
# Сколько строк показывать в топах аналитики.
ANALYTICS_TOP=5

# Недельный отчёт в Lark-группу. По умолчанию выключен: включите осознанно.
WEEKLY_REPORT_ENABLED=false
WEEKLY_REPORT_HOUR=8
WEEKLY_CHECK_INTERVAL=300

# Сколько уходов в офлайн за период делают робота кандидатом на ремонт/замену.
RETIREMENT_MIN_OFFLINES=3
