# Живой тест бота через Telegram (см. LIVE_TEST.md).
#
# Скопируйте этот файл в .env.livetest и вставьте ТОЛЬКО тестовые значения.
# .env.livetest исключён из Git: секреты в репозиторий не попадают.
#
# НИ ОДНО значение отсюда не должно совпадать с продовым .env:
# запускатель сравнивает их и отказывается стартовать при совпадении.

# Токен тестового бота: @test_tk_1_bot (id 8846779761).
#
# Продовый @tk_servie_bot не подходит — запускатель его отвергает.
# Токен тестового бота лежит в `LarkBot/.env.livetest` (файл в .gitignore,
# права 600) — сюда его вписывать не нужно, это лишь шаблон.
#
# ВАЖНО: этого бота постоянно опрашивает чужой LaunchAgent
# (com.local.telegramphotobot, процесс TelegramPhotoBot/bot.py), поэтому
# Telegram отвечает `409 Conflict: terminated by other getUpdates request`
# (проверено живым getUpdates с timeout=25).
# Перед живым прогоном освободите бота:
#     launchctl unload ~/Library/LaunchAgents/com.local.telegramphotobot.plist
# после теста верните:
#     launchctl load ~/Library/LaunchAgents/com.local.telegramphotobot.plist
TELEGRAM_BOT_TOKEN=

# Белый список чатов: живой тест принимает сообщения только отсюда.
# Узнать id: python3 tools/live_test_bot.py discover
# ВАЖНО: тестовый бот не должен быть занят другим процессом.
TELEGRAM_ALLOWED_CHAT_IDS=

# Необязательно: ограничить приём одним топиком форум-группы.
# Пусто — принимается весь разрешённый чат. Значение — id топика (можно
# несколько через запятую) или имя топика.
TELEGRAM_LISTEN_TOPICS=

# Режим по умолчанию: live (полный прогон на стенд) или dry-run
# (живые ответы в Telegram, но ноль записей в базу и в Lark).
LIVE_TEST_MODE=live

# Порт локального стенда (PostgREST + Storage + Lark в памяти).
LIVE_TEST_PORT=8799
